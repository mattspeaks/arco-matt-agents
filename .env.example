# Copy to .env (gitignored). No secrets live here: auth is Windows (SQL) and your Claude Code login.

# SQL Server connection (ODBC). Default: LocalDB with Windows auth.
ARCO_DB_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=(localdb)\MSSQLLocalDB;Database=ArcoAgents;Trusted_Connection=yes;TrustServerCertificate=yes;

# Optional: full path to the Claude Code CLI if `claude` isn't on PATH.
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
